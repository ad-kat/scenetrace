# Provider mode: mock | live | hybrid
SCENETRACE_MODE=mock

SCENETRACE_MEDIA_DIR=./media
SCENETRACE_CORS_ORIGINS=http://localhost:5173

# --- Live / VAST VSS credentials (required for live or hybrid mode) ---
# Set these to the values provided by the hackathon organizers.
# Organizer deploy Secret maps INGRESS_URL / USERNAME / PASSWORD as fallbacks.
VSS_URL=https://team-34-vss.thecosmoslabs.com
VSS_USERNAME=
VSS_PASSWORD=

# --- Legacy / optional ---
VAST_API_URL=
VAST_API_KEY=
NVIDIA_API_KEY=
WANDB_API_KEY=
WANDB_MODEL=
SEARCH_TIMEOUT_SECONDS=30
REASONING_TIMEOUT_SECONDS=45
